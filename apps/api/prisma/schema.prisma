// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(uuid())
  displayName    String
  email          String        @unique
  passwordHash   String
  profilePicture String?
  uploads        Upload[]
  photos         Photo[]
  memberships    EventMember[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum EventRole {
  ADMIN
  CONTRIBUTOR
  VIEWER
}

model Event {
  eventId   String   @id @default(uuid())
  name      String
  iconURL   String?
  eventCode String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  uploads   Upload[]
  photos    Photo[]

  members    EventMember[]
  identities Identity[]
}

model EventMember {
  userId   String
  eventId  String
  role     EventRole
  joinedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

enum StorageProvider {
  MINIO
  S3
}

enum PhotoProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Photo {
  id String @id @default(uuid())

  eventId    String
  uploaderId String
  uploadId   String

  originalName    String
  storageKey      String
  mimeType        String
  size            Int
  annotation      PhotoAnnotation?
  upload          Upload           @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  storageProvider StorageProvider  @default(MINIO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  detectedFaces    DetectedFace[]
  processingStatus PhotoProcessingStatus @default(PENDING)

  processingStartedAt   DateTime?
  processingCompletedAt DateTime?

  processingError String?

  @@index([uploadId])
  @@index([eventId])
  @@index([uploaderId])
}

enum EmbeddingModel {
  ARCFACE
}

model DetectedFace {
  id String @id @default(uuid())

  photoId String

  // Face Detection
  boundingBoxX Float
  boundingBoxY Float
  boundingBoxW Float
  boundingBoxH Float

  confidence Float

  // Facial Landmarks
  leftEyeX Float
  leftEyeY Float

  rightEyeX Float
  rightEyeY Float

  noseX Float
  noseY Float

  leftMouthX Float
  leftMouthY Float

  rightMouthX Float
  rightMouthY Float

  // Identity (assigned later)
  identityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo    Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade)
  identity Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  vector FaceVector?

  @@index([photoId])
  @@index([identityId])
}

model FaceVector {
  id String @id @default(uuid())

  detectedFaceId String @unique

  vector Unsupported("vector(512)")

  model EmbeddingModel

  embeddingVersion Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detectedFace DetectedFace @relation(fields: [detectedFaceId], references: [id], onDelete: Cascade)

  @@index([model])
  @@index([embeddingVersion])
}

enum UploadStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

model Upload {
  id String @id @default(uuid())

  eventId    String
  uploaderId String

  status UploadStatus @default(PENDING)

  totalFiles    Int
  uploadedFiles Int @default(0)
  failedFiles   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  photos Photo[]

  @@index([eventId])
  @@index([uploaderId])
}

model PhotoAnnotation {
  id String @id @default(uuid())

  photoId String @unique

  caption String

  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
}

model Identity {
  id String @id @default(uuid())

  eventId String

  displayName String?

  isConfirmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  faces DetectedFace[]

  @@index([eventId])
}
